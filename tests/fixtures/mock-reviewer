#!/usr/bin/env bash
# mock-reviewer — doubt-driven 검증 백엔드(claude)를 흉내내는 테스트용 실행 파일
#
# MOCK_REVIEW:
#   pass     (기본) 반증 후 통과 → VERDICT: PASS
#   fail     결함 발견 → VERDICT: FAIL
#   noverdict VERDICT 라인 없음 (안전 기본값 검증용)
#   slow     10초 sleep (타임아웃 테스트용)
#   error    exit 1 (실행 실패 검증용)
set -euo pipefail

case "${MOCK_REVIEW:-pass}" in
  pass)
    cat > /dev/null
    printf '의뢰 제약을 모두 충족하며 경계 조건도 문제없음.\nVERDICT: PASS\n'
    ;;
  fail)
    cat > /dev/null
    printf 'Defects:\n- 빈 입력 처리 누락\n- 반환 타입 불일치\nVERDICT: FAIL\n'
    ;;
  noverdict)
    cat > /dev/null
    printf '검토했으나 명확한 판정을 내리지 못함.\n'
    ;;
  slow)
    cat > /dev/null
    sleep 10
    ;;
  error)
    cat > /dev/null
    echo "mock-reviewer: simulated failure" >&2
    exit 1
    ;;
  *)
    echo "mock-reviewer: unknown MOCK_REVIEW=${MOCK_REVIEW}" >&2
    exit 99
    ;;
esac
